//@version=5
// ============================================================================
//  SPY — IBS MEAN REVERSION STRATEGY  (matches the Python/Colab backtest)
// ----------------------------------------------------------------------------
//  Rules:
//    IBS (Internal Bar Strength) = (close - low) / (high - low)
//    ENTRY : IBS < 0.20  ->  buy at the OPEN of the next bar
//    EXIT  : IBS > 0.80  ->  close position at the OPEN of the next bar
//
//  Pine's strategy engine fills strategy.entry()/strategy.close() orders at
//  the open of the bar AFTER the signal bar closes (default behavior, no
//  calc_on_order_fills / calc_on_every_tick needed). This mirrors the
//  position.shift(1) used in the Python backtest -> no look-ahead bias,
//  same execution convention on both platforms.
//
//  Use on SPY, Daily timeframe.
// ============================================================================
strategy("SPY IBS Mean Reversion (Entry<0.20 / Exit>0.80)",
     shorttitle = "IBS-MR",
     overlay = false,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.0,      // set to your broker's actual commission, e.g. 0.03
     slippage = 0,                // set >0 ticks to stress-test realistic fills
     process_orders_on_close = false)

// ---------------------------------------------------------------------------
// Inputs (kept adjustable so you can re-run the same grid search on TV)
// ---------------------------------------------------------------------------
ibsEntryLevel = input.float(0.20, title = "IBS Entry Threshold (Buy when IBS < this)", minval = 0.0, maxval = 1.0, step = 0.01)
ibsExitLevel  = input.float(0.80, title = "IBS Exit Threshold (Sell when IBS > this)",  minval = 0.0, maxval = 1.0, step = 0.01)

startDate = input.time(timestamp("1993-01-01"), title = "Backtest Start Date")
endDate   = input.time(timestamp("2099-01-01"), title = "Backtest End Date")
inDateRange = (time >= startDate) and (time <= endDate)

// ---------------------------------------------------------------------------
// Indicator — Internal Bar Strength
// ---------------------------------------------------------------------------
barRange = high - low
ibs = barRange != 0 ? (close - low) / barRange : 0.5   // guard against high==low

// ---------------------------------------------------------------------------
// Signals (evaluated on THIS bar's close; Pine fills on the NEXT bar's open
// by default, which is the equivalent of the Python position.shift(1))
// ---------------------------------------------------------------------------
longCondition  = inDateRange and (ibs < ibsEntryLevel)
closeCondition = ibs > ibsExitLevel

if (longCondition)
    strategy.entry("IBS Long", strategy.long)

if (closeCondition)
    strategy.close("IBS Long")

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plot(ibs, title = "IBS", color = color.new(color.blue, 0), linewidth = 2)
hline(ibsEntryLevel, title = "Entry Level", color = color.new(color.green, 0), linestyle = hline.style_dashed)
hline(ibsExitLevel,  title = "Exit Level",  color = color.new(color.red, 0),   linestyle = hline.style_dashed)
hline(0.5, title = "Midline", color = color.new(color.gray, 60))

bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na, title = "In-Position Highlight")

// ---------------------------------------------------------------------------
// On-chart equity/exposure info (optional table, top-right)
// ---------------------------------------------------------------------------
var table infoTable = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Net Profit %", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 1, 0, str.tostring(strategy.netprofit / strategy.initial_capital * 100, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 0, 1, "Max DD %", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 1, 1, str.tostring(strategy.max_drawdown / strategy.initial_capital * 100, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 0, 2, "Total Trades", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 1, 2, str.tostring(strategy.closedtrades), text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(infoTable, 0, 3, "Win Rate %", text_color = color.white, bgcolor = color.new(color.black, 0))
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(infoTable, 1, 3, str.tostring(winRate, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.black, 0))
